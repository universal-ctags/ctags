--langdef=RGC
--map-RGC=+.rg
--kinddef-RGC=f,function,functions
--kinddef-RGC=c,class,classes
--kinddef-RGC=e,enum,enums
--kinddef-RGC=i,interface,interfaces
--kinddef-RGC=m,member,members

--_tabledef-RGC=main
--_mtable-regex-RGC=main/^[ \t]*def[ \t]+([A-Za-z_][A-Za-z0-9_]*)/\1/f/
--_mtable-regex-RGC=main/^[ \t]*class[ \t]+([A-Za-z_][A-Za-z0-9_]*)/\1/c/
--_mtable-regex-RGC=main/^[ \t]*enum[ \t]+([A-Za-z_][A-Za-z0-9_]*)/\1/e/
--_mtable-regex-RGC=main/^[ \t]*interface[ \t]+([A-Za-z_][A-Za-z0-9_]*)/\1/i/
--_mtable-regex-RGC=main/^[ \t]+([A-Za-z_][A-Za-z0-9_]*)[ \t]*:[ \t]*[A-Za-z_][A-Za-z0-9_]*/\1/m/
--_mtable-regex-RGC=main/[^\n]*[\n]//
--_mtable-regex-RGC=main/.//